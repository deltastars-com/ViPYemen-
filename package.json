{
  "name": "vip-yemen-platform",
  "private": true,
  "version": "6.10.3",
  "type": "module",
  "description": "ViP Yemen — منصة التوظيف والتسويق العقاري والإلكتروني والخدمات البرمجية",
  "scripts": {
    "postinstall": "node scripts/postinstall-build.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "convex:dev": "convex dev --once",
    "loadtest": "node scripts/loadtest.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "icons:store": "node scripts/generate-icons.mjs --store",
    "icons:official": "node scripts/generate-icons-from-official.mjs",
    "store:check": "node scripts/validate-store-listing.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource/cairo": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "@vercel/analytics": "^2.0.1",
    "capacitor-native-biometric": "^4.2.2",
    "convex": "^1.48.0",
    "framer-motion": "^12.43.0",
    "lucide-react": "^0.577.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "harfbuzzjs": "^1.6.4",
    "opentype.js": "^2.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^1.3.0"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "brace-expansion": "^5.0.11",
    "source-map-js": "^1.2.2",
    "serialize-javascript": "^7.1.2",
    "fast-uri": "^3.1.8"
  }
