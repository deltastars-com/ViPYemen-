{
  "name": "vip-yemen-platform",
  "private": true,
  "version": "6.8.6",
  "type": "module",
  "description": "ViP Yemen — منصة التوظيف والتسويق العقاري والإلكتروني والخدمات البرمجية",
  "scripts": {
    "postinstall": "node scripts/postinstall-build.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "convex:dev": "convex dev --once",
    "loadtest": "node scripts/loadtest.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "icons:store": "node scripts/generate-icons.mjs --store"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource/cairo": "^5.2.5",
    "@supabase/supabase-js": "^2.117.3",
    "@vercel/analytics": "^2.0.1",
    "capacitor-native-biometric": "^4.2.2",
    "convex": "^1.47.0",
    "framer-motion": "^14.3.0",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "harfbuzzjs": "^1.6.3",
    "opentype.js": "^2.0.0",
    "tailwindcss": "^4.1.11",
    "typescript": "~5.9",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^1.0.1"
